// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client"
  output        = "../src/generated/client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "sqlite"
  url       = "file:./dev.db"
  // provider  = "postgresql"
  // url       = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String   // In a real app, this should be hashed. For Phase 1 prototype, we'll store as is or simple hash.
  createdAt DateTime @default(now())
  
  player    Player?
}

model Player {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id])
  
  // Character Identity
  isCreated Boolean  @default(false) // True only after character creation screen
  username  String   // Character Name (can differ from login)
  nameChangeCount Int @default(0) // Max 1
  
  skin      String   @default("player_idle")
  house     String   @default("ignis") // ignis, axiom, vesper
  
  // Persistence
  x         Float    @default(300)
  y         Float    @default(300)
  prestige  Int      @default(0)
  gold      Int      @default(0)

  // Progression & Alignment (Fable System)
  xp             Int @default(0) // Personal Level
  alignment      Int @default(0) // -100 (Dark) to +100 (Light)
  academicPoints Int @default(0) // PA (School Grades)
  detentionWork  Int @default(0) // Remaining punishment tasks
  
  // Persistence for Status Effects
  unconsciousUntil BigInt @default(0) // Timestamp (ms) stored as BigInt
  
  // Body Claiming Persistence
  echoId    String? @unique // The ID of the Echo this player possesses (e.g. "student_ignis_1")

  // Future proofing for Phase 2
  health    Int      @default(100)
  maxHealth Int      @default(100)

  inventory InventoryItem[]
}

model WorldState {
  id        Int     @id @default(1) // Singleton ID usually 1
  
  // House Cup
  ignisPoints   Int @default(0)
  axiomPoints   Int @default(0)
  vesperPoints  Int @default(0)
  
  // Time Persistence (if offset from real time)
  timeOffset    BigInt @default(0)
  
  lastSaved     DateTime @default(now())
}

model InventoryItem {
  id        Int    @id @default(autoincrement())
  playerId  Int
  player    Player @relation(fields: [playerId], references: [id])
  
  itemId    String // e.g. "sword_wood", "potion_hp"
  count     Int    @default(1)
  
  equipped  Boolean @default(false) // Is this item currently equipped?
}